# =============================================================================
# Arabic OCR Pipeline — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored; this `.env.example` is the committed template.
# =============================================================================

# -----------------------------------------------------------------------------
# Ollama (local node — Dell Pro Max GB10)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Primary vision model. qwen2.5vl:7b is the verified best for Arabic OCR.
# deepseek-ocr is a strong alternative (purpose-built OCR, ~3B params).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_VISION_FALLBACK=qwen3-vl:latest
# Text model used for the post-OCR correction pass (--correct flag).
OLLAMA_POSTPROCESS_MODEL=qwen2.5-coder:14b
OLLAMA_POSTPROCESS_ENABLED=false
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=3
OLLAMA_BACKOFF_BASE=2.0
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=8192
# Keep models resident in GPU memory (avoid reload latency).
OLLAMA_KEEP_ALIVE=5m
# Serialize all inference calls through one queue (prevents GPU overload).
OLLAMA_QUEUE_INFERENCE=true
# Downscale page images to this max long-edge dimension before sending.
OLLAMA_MAX_IMAGE_DIM=1500

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
INPUT_DIR=./input
OUTPUT_DIR=./output
OCR_DPI=300
# Keep low (1) to avoid GPU overheating.
OCR_WORKERS=1
# 0 = all pages; set a number to limit pages per PDF (testing).
OCR_MAX_PAGES=0
OCR_CACHE_DIR=./.ocr_cache
OCR_USE_CACHE=true
OCR_STATE_FILE=./.ocr_state.json
OCR_RTL=true
OCR_FONT_FAMILY='Amiri', 'Traditional Arabic', 'Scheherazade New', serif
# Calibre ebook-convert binary (for MOBI). Empty = auto-detect via PATH.
EBOOK_CONVERT=

# -----------------------------------------------------------------------------
# OpenCV preprocessing (applied before vision OCR)
# mode: off | light (contrast only) | full (deskew+binarize+denoise+contrast)
# -----------------------------------------------------------------------------
PREPROCESS_MODE=off
PREPROCESS_ENABLED=false
PREPROCESS_DESKEW=true
PREPROCESS_BINARIZE=false
PREPROCESS_DENOISE=false
PREPROCESS_NORMALIZE_CONTRAST=false

# -----------------------------------------------------------------------------
# GPU thermal guard (prevents overheating / system crashes)
# -----------------------------------------------------------------------------
THERMAL_GUARD_ENABLED=true
# Pause threshold (°C) — block new work above this.
THERMAL_MAX_TEMP=70.0
# Critical peak (°C) — force a cooldown after a page that reached this.
THERMAL_CRITICAL_TEMP=75.0
# Seconds between temperature checks while cooling.
THERMAL_POLL_INTERVAL=5.0
# Seconds between background temperature samples (peak tracking).
THERMAL_MONITOR_INTERVAL=2.0
# Base breathing room between pages (seconds).
THERMAL_INTER_PAGE_DELAY=2.0

# -----------------------------------------------------------------------------
# Remote host `latitude` — all optional & fail-soft (disabled by default)
# -----------------------------------------------------------------------------
# Redis (idempotent state tracking)
REDIS_ENABLED=false
REDIS_HOST=latitude
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=arabic_ocr

# PostgreSQL (execution logs, metadata, ToC)
POSTGRES_ENABLED=false
POSTGRES_HOST=latitude
POSTGRES_PORT=5432
POSTGRES_DB=arabic_ocr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Elasticsearch (full-text Arabic search)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=http://latitude:9200
ELASTICSEARCH_INDEX=arabic_ocr_pages

# Qdrant (local vector embeddings for RAG)
QDRANT_ENABLED=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=arabic_ocr_pages

# Neo4j (local knowledge graph)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# MySQL (optional secondary relational store)
MYSQL_ENABLED=false
MYSQL_HOST=latitude
MYSQL_PORT=3306
MYSQL_DB=arabic_ocr
MYSQL_USER=root
MYSQL_PASSWORD=
